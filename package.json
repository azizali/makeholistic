{
  "name": "makeholistic",
  "private": true,
  "type": "module",
  "scripts": {
    "netlify:serve": "pnpx netlify serve",
    "dev": "NODE_OPTIONS='--import ./instrument-server.mjs' vite dev --port 3000",
    "build": "vite build && cp instrument-server.mjs .netlify/v1/functions/",
    "preview": "vite preview",
    "format": "biome format",
    "format:fix": "biome format --write",
    "lint": "biome lint",
    "lint:fix": "biome lint --fix",
    "check": "biome check",
    "check:fix": "biome check --write",
    "start": "node --import ./.netlify/v1/functions/instrument-server.mjs .netlify/v1/functions/index.mjs",
    "db:migrate": "dotenv -e .env.local -- drizzle-kit migrate",
    "db:generate": "dotenv -e .env.local -- drizzle-kit generate",
    "db:push": "dotenv -e .env.local -- drizzle-kit push",
    "db:pull": "dotenv -e .env.local -- drizzle-kit pull",
    "db:studio": "drizzle-kit studio",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,css,md}": [
      "biome check . --write",
      "git add"
    ]
  },
  "dependencies": {
